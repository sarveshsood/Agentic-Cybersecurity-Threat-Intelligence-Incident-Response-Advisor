{
  "info": {
    "name": "ACTIRA API",
    "description": "Core ACTIRA endpoints for demos and integration tests. Set collection variables baseUrl, email, password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": "analyst@soc.example.com"
    },
    {
      "key": "password",
      "value": "Analyst123!"
    },
    {
      "key": "ingestKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (j.access_token) pm.collectionVariables.set('token', j.access_token);",
              "} catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "List incidents",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/incidents"
      }
    },
    {
      "name": "KPIs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/kpis"
      }
    },
    {
      "name": "KB search",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/kb/search?q=brute%20force&top_k=5"
      }
    },
    {
      "name": "Ingest raw log",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Ingest-Key",
            "value": "{{ingestKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Failed password for root from 203.0.113.10 port 22 ssh2\",\n  \"source\": \"postman\"\n}"
        },
        "url": "{{baseUrl}}/api/logs/ingest"
      }
    }
  ]
}
