# ACTIRA — frontend environment template
# Agentic Cybersecurity Threat Intelligence & Incident Response Advisor
# Copy to frontend/.env and adjust the port if your API is not on 8001.
#
#   Copy-Item .env.example .env
#
# Must match uvicorn --port. Prefer 127.0.0.1 over localhost when Docker/WSL
# is bound to the same port on IPv6.
#
# Do not append /api — the client adds /api automatically.

REACT_APP_BACKEND_URL=http://127.0.0.1:8001
