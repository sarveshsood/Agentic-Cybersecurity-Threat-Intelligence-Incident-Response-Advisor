%% ACTIRA — Deployment options
flowchart TB
  subgraph LocalDev
    LUI[npm start]
    LAPI[uvicorn :8001]
    LM[(Mongo local)]
  end

  subgraph Compose
    CUI[frontend container]
    CAPI[backend container]
    CM[(mongo:7)]
  end

  subgraph Kubernetes
