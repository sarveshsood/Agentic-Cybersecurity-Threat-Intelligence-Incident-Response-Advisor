# =============================================================================
# ACTIRA — backend environment template
# Agentic Cybersecurity Threat Intelligence & Incident Response Advisor
# =============================================================================
# Setup:
#   1. Copy this file → backend/.env
#        Windows:  Copy-Item .env.example .env
#        Unix:     cp .env.example .env
#   2. Fill real values below (never paste secrets into this .example file).
#   3. Start API:
#        uvicorn server:app --reload --host 0.0.0.0 --port 8001
#
# NEVER commit backend/.env (secrets). Only commit this .env.example.
#
# Two-layer config model
# ----------------------
#   backend/.env          → infrastructure + bootstrap (this file)
#   Admin → Settings UI   → runtime ops (LLM switch, HiTL, TI keys, Slack, etc.)
#                           Secrets resolve: MongoDB/Settings first, then .env
#                           Saving in the UI also syncs values back here so a
#                           new Mongo (or wiped volume) still boots correctly.
#
# Frontend (separate file): frontend/.env
#   REACT_APP_BACKEND_URL=http://127.0.0.1:8001
# Prefer 127.0.0.1 over localhost if Docker/WSL steals IPv6 localhost ports.
# =============================================================================


# -----------------------------------------------------------------------------
# Infrastructure (required)
# -----------------------------------------------------------------------------

# MongoDB connection string.
# Prefer this repo's compose (from project root):
#   docker compose up -d          # starts actira-mongodb on host port 27017
# Local examples:
#   mongodb://localhost:27017     # ACTIRA docker-compose.yml (recommended)
# Atlas:
#   mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Do not reuse another project's Mongo container/ports.
MONGO_URL=mongodb://localhost:27017

# Database name inside Mongo (created automatically on first write).
DB_NAME=soc_console

# Browser origins allowed by CORS (comma-separated, no spaces preferred).
# Must include the exact origin you open the UI from.
# Examples:
#   http://localhost:3000
#   http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Deployment environment: dev | test | local | staging | production
# Weak JWT is refused when ENV is not a lab env. Demo seed only runs in lab envs.
ENV=dev

# Dual-gate demo users (empty DB only): requires lab ENV AND this flag.
# Known passwords: analyst@ / reviewer@ / admin@  …@soc.example.com
# Never enable in production or staging.
SEED_DEMO_USERS=true

# H-07 / H-08 collaboration & productivity (default OFF). SPA: GET /api/meta/features
# Set to 1 for demos / lab. Gated routes return 404 when off.
# FEATURE_COLLAB_ASSIGN=1
# FEATURE_COLLAB_COMMENTS=1
# FEATURE_NOTIFICATION_CENTER=1
# FEATURE_SAVED_FILTERS=1
# FEATURE_PINS=1

# Real-time ops channels (SSE GET /api/sse/ops, WS /api/ws/ops). Default on.
# FEATURE_REALTIME_OPS=1

# Optional Prometheus/scrape token for GET /metrics (admin JWT also works).
# METRICS_TOKEN=

# JWT signing secret for login tokens. REQUIRED in any shared/prod deploy.
# Generate something long and random, e.g. PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])
# Changing this invalidates all existing sessions. Prefer ≥32 characters.
JWT_SECRET=generate-a-32-plus-char-random-string

# A-S3: master key for encrypt-at-rest of Settings secrets in Mongo (Fernet).
# Prefer an explicit key in staging/prod so rotating JWT_SECRET does not re-key vault.
# Generate Fernet key (Python):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or any long passphrase (hashed to a Fernet key). If unset, key is derived from JWT_SECRET.
# SECRETS_MASTER_KEY=

# Optional external vault / KMS (A-S3 ops stretch) — leave unset for local Fernet only.
# Hashicorp Vault Transit encrypt-at-rest + KV references (vault://path#field in Settings):
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=
# VAULT_TRANSIT_KEY=actira
# VAULT_TRANSIT_ENABLED=auto   # auto|1|0 — auto enables when addr+token set
# VAULT_KV_MOUNT=secret
# AWS Secrets Manager references (awssm://secret-id#json_key in Settings):
# AWS_REGION=us-east-1
# (uses default boto3 credential chain)

# Multi-node job payloads (default mongo = any worker can claim uploads):
# ACTIRA_JOB_PAYLOAD_BACKEND=mongo   # mongo | disk | dual
# ACTIRA_JOB_PAYLOAD_DIR=            # only for disk/dual local path

# Multi-worker / HA (see docs/MULTI_WORKER.md):
# ACTIRA_JOB_WORKER=1                # set 0 on secondary API replicas; 1 on worker pod
# JOB_STALE_MINUTES=30
# JOB_WORKER_POLL_SECONDS=1.5
# Optional AMQP wake-up only (NOT Celery; Mongo remains claim SoT):
# JOB_BROKER_ENABLED=0
# JOB_BROKER_URL=
# JOB_BROKER_QUEUE=actira.jobs

# -----------------------------------------------------------------------------
# Application logging (console + optional physical file)
# -----------------------------------------------------------------------------
# File logging is ON by default (rotating). Disable with LOG_TO_FILE=0.
# Every line includes [rid=…] [user=email] [uid=…] [role=…] for audit greps.
# LOG_TO_FILE=1
# LOG_DIR=backend/logs              # absolute path OK: C:\actira\logs or /var/log/actira
# LOG_FILE=actira.log               # filename only (no path separators)
# LOG_LEVEL=INFO                    # DEBUG|INFO|WARNING|ERROR
# LOG_FORMAT=text                   # text | json  (console + file default)
# LOG_FILE_FORMAT=json              # optional: JSON file while console stays text
# LOG_MAX_BYTES=10485760            # 10 MiB per file before rotate
# LOG_BACKUP_COUNT=10

# -----------------------------------------------------------------------------
# Threat intel HTTP resilience + enrichment pool
# -----------------------------------------------------------------------------
# TI_HTTP_TIMEOUT=8
# TI_HTTP_RETRIES=2
# TI_HTTP_BACKOFF_BASE=0.4
# TI_HTTP_PROXY=                    # or use HTTPS_PROXY / HTTP_PROXY
# TI_HTTP_CA_BUNDLE=                # corporate MITM CA path
# TI_HTTP_VERIFY_SSL=1              # set 0 only in lab
# TI_CIRCUIT_FAILURES=5
# TI_CIRCUIT_COOLDOWN_SECONDS=60
# ENRICH_CONCURRENCY=8              # parallel IoC workers (1–32)
# PARSE_CONCURRENCY=4               # parallel multi-file parse workers (1–16)

# -----------------------------------------------------------------------------
# Job artifacts (optional pipeline snapshots for replay)
# -----------------------------------------------------------------------------
# JOB_ARTIFACTS_ENABLED=0
# JOB_ARTIFACTS_DIR=backend/data/job_artifacts
# JOB_ARTIFACTS_MAX_BYTES=5000000
# JOB_ARTIFACTS_RETAIN_HOURS=168
# JOB_PAYLOAD_RETAIN=0              # keep upload bytes after done for full re-queue replay

# -----------------------------------------------------------------------------
# Log archival lifecycle
# -----------------------------------------------------------------------------
# LOG_ARCHIVE_ENABLED=1             # default follows LOG_TO_FILE
# LOG_ARCHIVE_DIR=backend/logs/archive
# LOG_ARCHIVE_RETAIN_DAYS=30

# Optional LLM USD price overrides (per 1M tokens):
# LLM_PRICE_TABLE_JSON={"anthropic:claude-sonnet-4-6":{"in":3,"out":15}}

# -----------------------------------------------------------------------------
# Audit WORM export + SIEM
# -----------------------------------------------------------------------------
# AUDIT_WORM_ENABLED=1
# AUDIT_WORM_DIR=backend/data/audit_worm
# AUDIT_SIEM_WEBHOOK_URL=https://siem.example.com/hooks/actira
# AUDIT_SIEM_TIMEOUT=5

# -----------------------------------------------------------------------------
# Optional AMQP broker (wake workers; Mongo still owns claims)
# -----------------------------------------------------------------------------
# JOB_BROKER_URL=amqp://guest:guest@localhost:5672/
# JOB_BROKER_QUEUE=actira.jobs
# JOB_BROKER_ENABLED=1
# Requires: pip install pika

# A-F1: SPA uses httpOnly cookie (actira_access_token). Login still returns access_token
# in JSON for API clients/tests. Set 0 to omit body token (cookie-only clients).
# AUTH_RETURN_TOKEN_IN_BODY=1
# Cookie attributes for cross-origin SPA (:3000 UI → :8001 API):
# COOKIE_SAMESITE=auto   # auto|lax|strict|none  (auto → none when CORS_ORIGINS set)
# COOKIE_SECURE=         # force 1/0; default Secure when SameSite=none


# -----------------------------------------------------------------------------
# Default LLM (process bootstrap)
# -----------------------------------------------------------------------------
# Used when MongoDB Settings doc is empty / on first boot defaults.
# Admin → Settings can override provider/model at runtime (stored in DB).
#
# LLM_PROVIDER: anthropic | openai | gemini | groq
LLM_PROVIDER=anthropic

# Must match the provider. Common UI choices:
#   anthropic → claude-sonnet-4-6 | claude-opus-4-8 | claude-haiku-4-5
#   openai    → gpt-5.4 | gpt-5.4-mini | gpt-5.2
#   gemini    → gemini-3.1-pro-preview | gemini-3-flash-preview | gemini-3.5-flash
#   groq      → llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
LLM_MODEL=claude-sonnet-4-6

# Sampling temperature (0 = deterministic, 1 = creative). UI: Settings → LLM.
LLM_TEMPERATURE=0.2

# Soft monthly token budget for playbook/investigation calls. 0 = unlimited.
LLM_TOKEN_BUDGET_MONTHLY=0

# Dual fallback is configured primarily in Admin → Settings (Mongo):
#   llm_fallback_enabled, llm_fallback_provider, llm_fallback_model, llm_manual_route
# Automatic: on primary failure → preferred fallback → FALLBACK_PROVIDER_ORDER.
# Manual: Settings → Manual routing = backup forces preferred fallback stack.
# Probe: POST /api/settings/test-llm  body {"route":"primary"|"backup"}
# Snapshot: GET /api/settings/llm-routes


# -----------------------------------------------------------------------------
# LLM API keys (bootstrap — optional if you only set keys in Admin → Settings)
# -----------------------------------------------------------------------------
# Only the key for your active LLM_PROVIDER is required for live playbooks.
# Empty / missing key → playbook may fall back to templates.
# Prefer pasting keys in Admin → Settings (admin role); UI saves to MongoDB
# and syncs these env vars so restarts stay consistent.
#
# Get keys:
#   Anthropic → https://console.anthropic.com
#   OpenAI    → https://platform.openai.com
#   Gemini    → https://aistudio.google.com
#   Groq      → https://console.groq.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=


# -----------------------------------------------------------------------------
# Pipeline & Human-in-the-Loop (HiTL)
# -----------------------------------------------------------------------------
# Also editable in Admin → Settings → Pipeline & HiTL (synced back here on save).

# Grounding score below this → force HiTL review (0.0–1.0).
GROUNDING_THRESHOLD=0.7

# Minimum severity that always requires human review.
# One of: low | medium | high | critical
HITL_SEVERITY_MIN=critical

# Non-critical incidents with grounding ≥ this value auto-approve (0.0–1.0).
AUTO_APPROVE_GROUNDING_MIN=0.9

# Minutes of event window when correlating multi-file / multi-event attacks.
CORRELATION_WINDOW_MINUTES=30


# -----------------------------------------------------------------------------
# Threat intelligence (optional — empty = mock enrichment for that source)
# -----------------------------------------------------------------------------
# Each key is independent. Live enrichment applies on the NEXT log ingest
# after a key is set (existing incidents keep their previous scores).
# Same dual path as LLM: Admin → Settings or this file.
# UI shows 7 rows under Settings → Threat intel (matches LIVE INTEL n/7 badge).
#
# Get keys:
#   AbuseIPDB  → https://www.abuseipdb.com
#   VirusTotal → https://www.virustotal.com
#   GreyNoise  → https://www.greynoise.io
#   ThreatFox  → https://threatfox.abuse.ch
#   OTX        → https://otx.alienvault.com
#   Shodan     → https://account.shodan.io
#   Cohere     → https://dashboard.cohere.com (Rerank for KB / playbook grounding)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
GREYNOISE_API_KEY=
THREATFOX_API_KEY=
OTX_API_KEY=
SHODAN_API_KEY=
# Cohere Rerank (7th TI row) — empty = skip live re-rank (lexical/hybrid only)
COHERE_API_KEY=
# Optional: force re-rank on/off even when key is set (1|0|true|false). Default on when key present.
# ACTIRA_COHERE_RERANK=1
# ACTIRA_COHERE_MODEL=rerank-english-v3.0


# -----------------------------------------------------------------------------
# Notifications (Slack + email)
# -----------------------------------------------------------------------------
# Slack install (Incoming Webhook — no bot OAuth required):
#   1. Open https://api.slack.com/messaging/webhooks
#   2. Create an Incoming Webhook → pick a SOC channel
#   3. Copy URL: https://hooks.slack.com/services/T…/B…/…
#   4. Paste below OR in Admin → Settings → Notifications → Send test Slack
#   5. Critical / high / HiTL incidents post to that channel
SLACK_WEBHOOK_URL=

# Recipient for critical / HiTL alert emails.
# Example: soc-oncall@company.com
EMAIL_ALERTS_TO=

# Email delivery: SMTP is OPTIONAL.
# Default: zero-config HTTP gateway (FormSubmit) — no SMTP details needed.
# EMAIL_HTTP_GATEWAY=true
#
# Optional SMTP upgrade (production):
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true
# Use a Google App Password: https://myaccount.google.com/apppasswords
EMAIL_HTTP_GATEWAY=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# JWT session lifetime in hours (also Admin → Settings → Security).
SESSION_TIMEOUT_HOURS=24

# Failed login attempts before a 15-minute lockout (per process).
FAILED_LOGIN_LOCKOUT=5

# Public self-registration (POST /auth/register + Login UI toggle).
# Auto policy when unset: off if OIDC enabled OR ENV is production/staging; on in lab.
# ALLOW_PUBLIC_REGISTER=false

# Optional OIDC SSO (authorization code + PKCE). Leave unset for password-only lab demos.
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:8001/api/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# OIDC_ROLE_CLAIM=
# OIDC_GROUP_ROLE_MAP={"soc-admins":"admin"}

# Optional OpenTelemetry OTLP (soft dependency — install otel packages separately).
# ACTIRA_OTEL_ENABLED=0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=actira


# -----------------------------------------------------------------------------
# Data retention
# -----------------------------------------------------------------------------
# How long to keep incidents (days). Used for policy + future purge jobs.
INCIDENT_RETENTION_DAYS=90

# Threat-intel enrichment cache TTL in hours.
ENRICHMENT_CACHE_TTL_HOURS=24


# -----------------------------------------------------------------------------
# Realtime log ingest (webhook / SIEM push)
# -----------------------------------------------------------------------------
# Shared secret for machine-to-machine push without a user JWT.
# Send as header:  X-Ingest-Key: <this value>
#
# Endpoints:
#   POST /api/logs/ingest       JSON  {"text":"...", "source":"rsyslog"}
#   POST /api/logs/ingest/raw   raw body (text/plain) + optional X-Log-Source
#
# Leave empty to require Bearer JWT only.
INGEST_API_KEY=


# =============================================================================
# Local stack checklist (this repo’s usual ports)
# =============================================================================
#   MongoDB  → 27017 (or 27018 if Docker mapped that way — match MONGO_URL)
#   Backend  → uvicorn ... --port 8001   → http://127.0.0.1:8001/api/
#   Frontend → npm start in frontend/    → http://127.0.0.1:3000
#   frontend/.env:
#     REACT_APP_BACKEND_URL=http://127.0.0.1:8001
#
# Health checks:
#   curl http://127.0.0.1:8001/api/
#   open  http://127.0.0.1:8001/docs
#   open  http://127.0.0.1:3000
#
# Demo accounts (seeded on first backend boot if users collection is empty):
#   admin@soc.example.com    / Admin123!
#   analyst@soc.example.com  / Analyst123!
#   reviewer@soc.example.com / Reviewer123!
#
# After env changes: restart uvicorn. After frontend/.env changes: restart npm start.
# Then finish runtime config as admin: Settings → LLM / HiTL / TI / Save all settings.
#
# Realtime ingest smoke test (after setting INGEST_API_KEY):
#   curl -X POST http://127.0.0.1:8001/api/logs/ingest ^
#     -H "Content-Type: application/json" ^
#     -H "X-Ingest-Key: YOUR_KEY" ^
#     -d "{\"text\":\"Failed password for root from 1.2.3.4\",\"source\":\"curl\"}"
# =============================================================================

# Optional TOTP MFA for password login (requires: pip install pyotp)
# FEATURE_MFA=0
# Prefer IdP MFA (Entra/Okta). Optional ACTIRA claim check on OIDC callback:
# OIDC_REQUIRE_MFA=0
# OIDC_MFA_ACR_VALUES=AAL2,2
# OIDC_MFA_CLAIM=

# Embedding profile: auto (sbert in production/staging, hash in lab/CI)
#   offline = hash | quality/sbert = try sentence-transformers (fallback hash)
# ACTIRA_EMBEDDING_PROFILE=auto
# ACTIRA_EMBEDDING_BACKEND=   # explicit overrides profile
# Optional dense model (not in base requirements):
#   pip install sentence-transformers

# Multi-tenant scaffold on primary incident/user paths (default off — single-tenant product)
# FEATURE_MULTI_TENANT=0
# ACTIRA_DEFAULT_ORG_ID=default

# Optional LLM second-pass playbook judge (rules always run; costs tokens when on)
# ACTIRA_PLAYBOOK_JUDGE_LLM=0
# ACTIRA_PLAYBOOK_JUDGE_LLM=auto   # enable LLM pass only in production/staging
